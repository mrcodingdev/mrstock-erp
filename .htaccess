# MrStock ERP - Hardening de Producao Apache (Hostinger / cPanel)
Options -Indexes

# Unifica o domínio público antes de avaliar a sessão no PHP.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Protege arquivos de trabalho e preserva o manual vinculado no ERP.
    RewriteRule ^(?:database|tests|\.git|\.github|\.codex|\.agents|\.env(?:\.[^/]+)?|AGENTS\.md)(?:/|$) - [F,NC]
    RewriteRule ^docs(?:$|/(?!MRSTOCK_MANUAL_DO_USUARIO_v2\.2\.0_FINAL\.pdf$)) - [F,NC]

    RewriteCond %{HTTP_HOST} ^www\.mrstock\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://mrstock.com.br%{REQUEST_URI} [R=308,L,NE]
</IfModule>

# Pagina 404 Customizada Institucional
ErrorDocument 404 /404.php

# Bloqueia acesso direto a configuracoes, ambiente, logs, documentacao, sql, json e txt internos
<FilesMatch "^(\.env|\.git|\.htaccess|.*\.sql|.*\.log|.*\.md|.*\.json|.*\.txt)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Excecao para permitir o robots.txt
<Files "robots.txt">
    Order Allow,Deny
    Allow from all
</Files>

# O manual continua disponível por link e pede para ficar fora da busca.
<IfModule mod_headers.c>
    <Files "MRSTOCK_MANUAL_DO_USUARIO_v2.2.0_FINAL.pdf">
        Header always set X-Robots-Tag "noindex"
    </Files>
</IfModule>

# Headers de Seguranca Defensivos (SecurityHeaders A+ Compliance)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Cache-Control e Expires de 1 Ano para Ativos Estaticos (Lighthouse CWV)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|woff|woff2|svg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>
