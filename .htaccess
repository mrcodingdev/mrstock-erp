# MrStock ERP - Hardening de Producao Apache (ProFreeHost / Unaux)
Options -Indexes

# Bloqueia acesso direto a arquivos de configuracao, ambiente, logs, documentacao e dumps SQL
<FilesMatch "^(\.env|\.git|\.htaccess|.*\.sql|.*\.log|.*\.md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Headers de Seguranca Defensivos
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
