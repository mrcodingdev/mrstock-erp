# ====================================================================
# MrStock ERP - Arquivo de Configuração de Ambiente (.env)
# ====================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu servidor.
# O arquivo .env NUNCA deve ser commitado no Git (já configurado no .gitignore).

# Ambiente da Aplicação (development | production)
APP_ENV=development
APP_URL=http://localhost/MrStock

# Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mrstock_db
DB_USER=root
DB_PASS=

# Configurações de Segurança e Sessão
SESSION_LIFETIME=0
